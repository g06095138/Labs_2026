digraph Schema {
graph [rankdir=LR, bgcolor=white, pad=0.4, nodesep=0.8, ranksep=1.3, label="АИС «Служба такси» — датологическая модель
База данных TaxiService_Db · PostgreSQL", labelloc=t, fontsize=22, fontname="DejaVu Sans"];
node [shape=plain,fontname="DejaVu Sans"]; edge [fontname="DejaVu Sans",fontsize=11];
clients [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD COLSPAN="3" BGCOLOR="#dceafa"><B>clients</B></TD></TR><TR><TD PORT="left_id" ALIGN="LEFT">PK</TD><TD ALIGN="LEFT"><B>id</B></TD><TD PORT="right_id" ALIGN="LEFT">SERIAL</TD></TR><TR><TD PORT="left_full_name" ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>full_name</B></TD><TD PORT="right_full_name" ALIGN="LEFT">VARCHAR(150), NOT NULL</TD></TR><TR><TD PORT="left_phone" ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>phone</B></TD><TD PORT="right_phone" ALIGN="LEFT">VARCHAR(50)</TD></TR></TABLE>>];
drivers [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD COLSPAN="3" BGCOLOR="#dceafa"><B>drivers</B></TD></TR><TR><TD PORT="left_id" ALIGN="LEFT">PK</TD><TD ALIGN="LEFT"><B>id</B></TD><TD PORT="right_id" ALIGN="LEFT">SERIAL</TD></TR><TR><TD PORT="left_full_name" ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>full_name</B></TD><TD PORT="right_full_name" ALIGN="LEFT">VARCHAR(150), NOT NULL</TD></TR><TR><TD PORT="left_car_name" ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>car_name</B></TD><TD PORT="right_car_name" ALIGN="LEFT">VARCHAR(100), NOT NULL</TD></TR><TR><TD PORT="left_car_number" ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>car_number</B></TD><TD PORT="right_car_number" ALIGN="LEFT">VARCHAR(30), NOT NULL</TD></TR><TR><TD PORT="left_is_available" ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>is_available</B></TD><TD PORT="right_is_available" ALIGN="LEFT">BOOLEAN, NOT NULL, DEFAULT TRUE</TD></TR></TABLE>>];
tariffs [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD COLSPAN="3" BGCOLOR="#dceafa"><B>tariffs</B></TD></TR><TR><TD PORT="left_id" ALIGN="LEFT">PK</TD><TD ALIGN="LEFT"><B>id</B></TD><TD PORT="right_id" ALIGN="LEFT">SERIAL</TD></TR><TR><TD PORT="left_name" ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>name</B></TD><TD PORT="right_name" ALIGN="LEFT">VARCHAR(100), NOT NULL</TD></TR><TR><TD PORT="left_base_price" ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>base_price</B></TD><TD PORT="right_base_price" ALIGN="LEFT">NUMERIC(10,2), NOT NULL</TD></TR><TR><TD PORT="left_price_per_km" ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>price_per_km</B></TD><TD PORT="right_price_per_km" ALIGN="LEFT">NUMERIC(10,2), NOT NULL</TD></TR></TABLE>>];
orders [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD COLSPAN="3" BGCOLOR="#dceafa"><B>orders</B></TD></TR><TR><TD PORT="left_id" ALIGN="LEFT">PK</TD><TD ALIGN="LEFT"><B>id</B></TD><TD PORT="right_id" ALIGN="LEFT">SERIAL</TD></TR><TR><TD PORT="left_client_id" ALIGN="LEFT">FK</TD><TD ALIGN="LEFT"><B>client_id</B></TD><TD PORT="right_client_id" ALIGN="LEFT">INTEGER, NOT NULL</TD></TR><TR><TD PORT="left_driver_id" ALIGN="LEFT">FK</TD><TD ALIGN="LEFT"><B>driver_id</B></TD><TD PORT="right_driver_id" ALIGN="LEFT">INTEGER, NULL</TD></TR><TR><TD PORT="left_tariff_id" ALIGN="LEFT">FK</TD><TD ALIGN="LEFT"><B>tariff_id</B></TD><TD PORT="right_tariff_id" ALIGN="LEFT">INTEGER, NOT NULL</TD></TR><TR><TD PORT="left_pickup_address" ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>pickup_address</B></TD><TD PORT="right_pickup_address" ALIGN="LEFT">TEXT, NOT NULL</TD></TR><TR><TD PORT="left_destination_address" ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>destination_address</B></TD><TD PORT="right_destination_address" ALIGN="LEFT">TEXT, NOT NULL</TD></TR><TR><TD PORT="left_distance_km" ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>distance_km</B></TD><TD PORT="right_distance_km" ALIGN="LEFT">DOUBLE PRECISION, NOT NULL, DEFAULT 4</TD></TR><TR><TD PORT="left_cost" ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>cost</B></TD><TD PORT="right_cost" ALIGN="LEFT">NUMERIC(10,2), NOT NULL</TD></TR><TR><TD PORT="left_status" ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>status</B></TD><TD PORT="right_status" ALIGN="LEFT">VARCHAR(50), NOT NULL, DEFAULT &#x27;Создан&#x27;</TD></TR><TR><TD PORT="left_created_at" ALIGN="LEFT"></TD><TD ALIGN="LEFT"><B>created_at</B></TD><TD PORT="right_created_at" ALIGN="LEFT">TIMESTAMP, NOT NULL, DEFAULT NOW()</TD></TR></TABLE>>];
clients:right_id:e -> orders:left_client_id:w [dir=both,arrowtail=teetee,arrowhead=crowodot,label="ON DELETE RESTRICT"];
drivers:right_id:e -> orders:left_driver_id:w [dir=both,arrowtail=teeodot,arrowhead=crowodot,label="ON DELETE SET NULL"];
tariffs:right_id:e -> orders:left_tariff_id:w [dir=both,arrowtail=teetee,arrowhead=crowodot,label="ON DELETE RESTRICT"];
legend [shape=box,fontsize=11,label="PK — первичный ключ; FK — внешний ключ
Клиент и тариф: у заказа ровно один
Водитель: у заказа ноль или один
У каждой родительской записи: ноль или много заказов
Один активный заказ на водителя — отдельное бизнес-правило"];
}