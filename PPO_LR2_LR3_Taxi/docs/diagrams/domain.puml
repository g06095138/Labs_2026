@startuml
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 16
skinparam shadowing false
skinparam backgroundColor white

hide empty members
skinparam classAttributeIconSize 0
left to right direction
title ЛР2–3. Классы финансового планирования такси
class FinancialPlan {
 + Id : Guid
 + Name : string
 + InitialCash : decimal
 + Months : ReadOnlyCollection<MonthParameters>
}
class MonthParameters {
 + Number : int
 + Quantity : int
 + Price : decimal
 + VariableCost : decimal
 + FixedCost : decimal
 + PaymentPercent : int
}
class MonthReport {
 + Number : int
 + OpeningCash : decimal
 + OpeningDebt : decimal
 + Revenue : decimal
 + VariableExpenses : decimal
 + ContributionMargin : decimal
 + TotalExpenses : decimal
 + Profit : decimal
 + CurrentPayment : decimal
 + Receipts : decimal
 + ClosingCash : decimal
 + ClosingDebt : decimal
 + HasDeficit : bool
}
class FinancialSummary {
 + TotalProfit : decimal
 + FinalCash : decimal
 + FinalDebt : decimal
 + RequiredFinancing : decimal
}
class PlanForecast {
 + PlanId : Guid
 + PlanName : string
 + Months : ReadOnlyCollection<MonthReport>
 + Summary : FinancialSummary
}
class PlanValidator {
 {static} + Validate(plan)
 {static} + ValidateMonth(month)
}
class FinancialCalculator {
 + CalculateMonth(month, openingCash, openingDebt) : MonthReport
 + Summarize(reports) : FinancialSummary
}
class ForecastService {
 + Forecast(plan) : PlanForecast
}
class ComparisonService {
 + Compare(left, right) : PlanComparison
}
class PlanComparison {
 + Left : ComparisonSide
 + Right : ComparisonSide
}
class ComparisonSide {
 + PlanId : Guid
 + PlanName : string
 + Summary : FinancialSummary
}
interface IPlanRepository {
 + SaveAsync(plan, ct)
 + ListAsync(ct)
 + LoadAsync(id, ct)
}
FinancialPlan "1" *-- "3" MonthParameters
PlanForecast "1" *-- "3" MonthReport
PlanForecast "1" *-- "1" FinancialSummary
PlanComparison "1" *-- "2" ComparisonSide
ComparisonSide --> FinancialSummary
FinancialCalculator ..> MonthParameters
FinancialCalculator ..> MonthReport
FinancialCalculator ..> FinancialSummary
FinancialCalculator ..> PlanValidator
ForecastService --> FinancialCalculator
ForecastService ..> PlanValidator
ForecastService ..> FinancialPlan
ForecastService ..> PlanForecast
ComparisonService --> ForecastService
ComparisonService ..> PlanComparison
IPlanRepository ..> FinancialPlan
note bottom of FinancialPlan
Входы копируются в read-only коллекцию.
Номера месяцев: уникальные 1, 2, 3.
end note
note bottom of ForecastService
Последовательность: cash=InitialCash, debt=0.
На каждом шаге перенос ClosingCash / ClosingDebt.
Формулы находятся только в Domain.
end note
@enduml
