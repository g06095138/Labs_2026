{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Собрать TelecomFinance",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/TelecomFinance.sln",
        "-c",
        "Debug"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Тесты ЛР3",
      "type": "process",
      "command": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/TelecomFinance.sln"
      ],
      "problemMatcher": "$msCompile",
      "group": "test"
    }
  ]
}
