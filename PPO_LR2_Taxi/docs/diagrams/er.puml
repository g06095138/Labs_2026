@startchen
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 18
left to right direction
entity "Финансовый план" as Plan {
 "Идентификатор плана" as Id <<key>>
 "Название" as Name
 "Начальные деньги" as InitialCash
}
' Месяц — слабая сущность; Number является частичным ключом.
' В основной SVG частичный ключ подчёркнут пунктиром.
' Дополнительное ограничение: ровно 3 месяца с Number=1,2,3.
entity "Месяц плана" as Month <<weak>> {
 "Номер месяца" as Number <<key>>
 "Количество поездок" as Quantity
 "Средняя цена поездки" as Price
 "Переменные затраты" as VariableCost
 "Постоянные расходы" as FixedCost
 "Процент оплаты" as PaymentPercent
}
relationship "Содержит" as Contains <<identifying>> {
}
Contains =1= Plan
Contains =N= Month
@endchen
